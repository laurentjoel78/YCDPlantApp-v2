{
    "cli": {
        "version": ">= 5.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "node": "20.19.4",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://ycdapp-production.up.railway.app"
            }
        },
        "preview": {
            "distribution": "internal",
            "node": "20.19.4",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://ycdapp-production.up.railway.app"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "node": "20.19.4",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://ycdapp-production.up.railway.app"
            },
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "production": {}
    }
}